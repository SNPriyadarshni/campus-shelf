rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Items collection - allow read for all authenticated users
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.ownerEmail.split('@')[0];
      allow update: if request.auth != null && 
        request.auth.uid == resource.data.ownerEmail.split('@')[0];
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.ownerEmail.split('@')[0];
    }
  }
}
